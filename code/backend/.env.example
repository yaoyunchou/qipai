# 数据库连接（必填，二选一）

# --- 本地 Docker（推荐开发）---
# 先运行: cd code && .\docker-db.ps1 up && .\setup-local-db.ps1
# 或复制模板: copy .env.local.docker .env
DATABASE_URL=postgresql+psycopg2://qipai:qipai_local_dev@127.0.0.1:5432/qipai
DATABASE_SSL_MODE=

# --- Supabase 云库（可选）---
# DATABASE_URL=postgresql+psycopg2://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
# DATABASE_SSL_MODE=require

JWT_SECRET=dev-secret-change-me

# 报销附件（本地默认 backend/uploads）
UPLOAD_DIR=uploads
UPLOAD_URL_PREFIX=/uploads

# 生产环境（Vercel）可选：自定义域名 CORS，逗号分隔
# CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
