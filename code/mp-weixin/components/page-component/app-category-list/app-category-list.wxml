<scroll-view class="app-category-list" style="{{'height:'+(''+noSetHeight?''+noSetHeight:''+setHeight)+';'}}" scroll-y="{{true}}"><block wx:for="{{list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['active',['$0',index],[[['list','',index]]]]]]]}}" class="app-item dir-left-nowrap" bindtap="__e"><view class="app-border" style="{{'background-color:'+(item.active===true?theme.background:inactiveBackground)+';'}}"></view><view class="{{['app-text',lastIndex==index&&mode=='border'?'last':'',nextIndex==index&&mode=='border'?'next':'']}}" style="{{'color:'+(item.active===true?theme.color:'')+';'+('background-color:'+(item.active===true?activeBackground:inactiveBackground)+';')}}">{{item.name}}</view></view></block></scroll-view>