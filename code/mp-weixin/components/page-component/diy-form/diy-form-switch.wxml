<view class="diy-form-switch main-between cross-center data-v-d0340e50" style="{{(cRadioStyle)}}"><view class="diy-form-label cross-center data-v-d0340e50" style="{{(cTitleStyle)}}"><view class="data-v-d0340e50"><view class="data-v-d0340e50">{{data.title}}</view><block wx:if="{{data.is_required=='1'&&data.title}}"><text class="data-v-d0340e50">*</text></block></view></view><view data-event-opts="{{[['tap',[['toggleSwitch',['$event']]]]]}}" class="evan-switch data-v-d0340e50" style="{{'width:'+(2*size+'px')+';'+('height:'+(switchHeight)+';')+('border-radius:'+(size+'px')+';')+('background-color:'+(is_open===true?data.open_color:data.close_color)+';')}}" bindtap="__e"><view class="evan-switch__circle data-v-d0340e50" style="{{'width:'+(radiusSize+'px')+';'+('height:'+(radiusSize+'px')+';')+('transform:'+(is_open===true?'translateX('+size+'px)':'translateX(0)')+';')+('margin:'+(margin)+';')}}"></view></view><block wx:if="{{is_show}}"><view class="switch-dialog main-center cross-center data-v-d0340e50" style="{{'padding:'+('0 '+data.inputPadding+'rpx')+';'}}"><block wx:if="{{data.open_text&&data.close_text}}"><view class="main-center cross-center data-v-d0340e50" style="{{(cDialogStyle)}}">{{is_open?data.open_text:data.close_text}}</view></block></view></block></view>