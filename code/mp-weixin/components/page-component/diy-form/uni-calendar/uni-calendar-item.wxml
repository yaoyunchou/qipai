<view data-event-opts="{{[['tap',[['choiceDate',['$0'],['weeks']]]]]}}" class="calendar-item__weeks-box main-center cross-center data-v-ef048182" style="{{$root.s0}}" bindtap="__e"><view class="calendar-item__weeks-box-item dir-top-nowrap main-center cross-center data-v-ef048182"><block wx:if="{{weeks.isDay}}"><text style="{{'color:'+(!weeks.disable&&!weeks.beforeMultiple&&weeks.fullDate!=calendar.fullDate?selectColor:'inherit')+';'}}" class="data-v-ef048182">今天</text></block><block wx:else><text class="data-v-ef048182">{{weeks.date}}</text></block><block wx:if="{{weeks.beforeMultiple}}"><text class="calendar-item__s data-v-ef048182">开始</text></block><block wx:if="{{weeks.afterMultiple}}"><text class="calendar-item__s data-v-ef048182">结束</text></block><block wx:if="{{weeks.beforeMultiple&&!weeks.afterTime}}"><view class="place__fixed data-v-ef048182"><view class="t-omit data-v-ef048182"></view><text class="data-v-ef048182">{{endTitle}}</text></view></block><block wx:if="{{weeks.afterMultiple}}"><view class="place__fixed data-v-ef048182"><view class="t-omit data-v-ef048182"></view><text class="data-v-ef048182">{{"共"+(hasKuatian==1?weeks.dayNum-1:weeks.dayNum)+placeUnit}}</text></view></block></view></view>