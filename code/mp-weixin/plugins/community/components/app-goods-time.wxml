<view class="app-goods-time data-v-265282a9"><view class="app-image data-v-265282a9" style="{{'background-color:'+(theme.background)+';'}}"></view><view class="app-goods-info data-v-265282a9"><text class="data-v-265282a9">￥</text><text class="app-goods-price data-v-265282a9">{{goods.price}}</text><block wx:if="{{status!==0&&goods.is_sales==1}}"><text class="app-goods-sales data-v-265282a9">{{"已抢"+goods.sales+goods.unit+"，剩"+goods.goods_stock+goods.unit}}</text></block></view><view class="app-content dir-top-nowrap data-v-265282a9"><block wx:if="{{status===1}}"><view class="app-text data-v-265282a9">距离结束仅剩</view></block><block wx:if="{{status===0}}"><view class="app-text data-v-265282a9">距离开始仅剩</view></block><block wx:if="{{status===2}}"><view class="app-text over-text data-v-265282a9">活动已结束</view></block><block wx:if="{{status!==2}}"><view class="app-time cross-center main-around data-v-265282a9"><block wx:if="{{day>0}}"><text class="app-num app-right data-v-265282a9">{{day}}</text></block><block wx:if="{{day>0}}"><text class="data-v-265282a9">天</text></block><text class="app-num app-right data-v-265282a9">{{hour}}</text><text class="data-v-265282a9">时</text><text class="app-num app-right data-v-265282a9">{{minute}}</text><text class="data-v-265282a9">分</text><text class="app-num app-right data-v-265282a9">{{second}}</text><text class="data-v-265282a9">秒</text></view></block></view></view>