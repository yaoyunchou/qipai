<view class="app-product-list data-v-f07142fa"><block wx:for="{{goods_list}}" wx:for-item="item" wx:for-index="index" wx:key="index"><view data-event-opts="{{[['tap',[['route_go',['$0'],[[['goods_list','',index]]]]]]]}}" class="app-item dir-left-nowrap data-v-f07142fa" bindtap="__e"><image class="app-image data-v-f07142fa" src="{{item.goods.cover_pic}}"></image><block wx:if="{{item.miaosha_num==0&&appSetting.is_show_stock=='1'}}"><view class="out-dialog data-v-f07142fa"><image src="{{appSetting.is_use_stock=='1'?appImg.plugins_out:appSetting.sell_out_pic}}" class="data-v-f07142fa"></image></view></block><view class="app-content box-grow-1 data-v-f07142fa"><text class="app-name data-v-f07142fa">{{item.goods.name}}</text><view class="app-progress main-between cross-center data-v-f07142fa"><view class="app-percentage data-v-f07142fa" style="{{'border-color:'+(theme.border)+';'}}"><view class="percentage data-v-f07142fa" style="{{'width:'+(''+item.goods.miaosha_percentage)+';'+('background:'+(theme.background)+';')}}"></view><view class="app-already data-v-f07142fa" style="{{'color:'+(theme.color)+';'}}">{{"已抢购"+item.goods.miaosha_count+item.goods.unit}}</view></view><view class="app-past data-v-f07142fa" style="{{'color:'+(theme.color)+';'}}">{{"仅剩"+item.goods.miaosha_num+item.goods.unit}}</view></view><view class="price-button dir-left-nowrap main-between cross-bottom data-v-f07142fa"><view class="price app-price dir-top-nowrap main-right cross-top data-v-f07142fa"><block wx:if="{{item.vip_card_appoint.discount}}"><app-sup-vip vue-id="{{'0949d59f-1-'+index}}" is_vip_card_user="{{item.vip_card_appoint.is_vip_card_user}}" margin="4rpx 0 0" discount="{{item.vip_card_appoint.discount}}" class="data-v-f07142fa" bind:__l="__l"></app-sup-vip></block><view class="{{['data-v-f07142fa',item.is_level&&(item.level_price>0||item.level_price==0)?'dir-top-nowrap':'dir-left-nowrap cross-bottom']}}" style="width:100%;"><view class="app-min-price data-v-f07142fa" style="{{'color:'+(theme.color)+';'}}"><block wx:if="{{item.priceList.priceInt>0||item.priceList.priceInt==0}}"><text class="price-float data-v-f07142fa">￥</text></block><text class="{{['price-int','data-v-f07142fa',item.priceList.priceInt>0||item.priceList.priceInt==0?'':'text']}}">{{item.priceList.priceInt}}</text><text class="price-float data-v-f07142fa">{{item.priceList.priceFloat}}</text></view><block wx:if="{{item.is_level&&(item.level_price>0||item.level_price==0)}}"><view class="app-member-price data-v-f07142fa" style="{{'background:'+(theme.background_p)+';'+('color:'+(theme.color)+';')}}"><view class="t-omit data-v-f07142fa">会员价<text class="price-float data-v-f07142fa">￥</text><text class="price-int data-v-f07142fa">{{item.memberList.priceInt}}</text><block wx:if="{{item.memberList.priceFloat!='.00'}}"><text class="price-float data-v-f07142fa">{{item.memberList.priceFloat}}</text></block></view></view></block><block wx:else><view class="app-original-price data-v-f07142fa">{{"￥"+item.goods.original_price}}</view></block></view></view><block wx:if="{{item.miaosha_num==0}}"><view class="app-button data-v-f07142fa" style="background-color:#CDCDCD;color:#fff;">下次再来</view></block><block wx:if="{{item.miaosha_num>0}}"><view class="app-button data-v-f07142fa" style="{{'color:#ffffff;'+('background-color:'+(item.buy_goods_auth?theme.background:'#999999')+';')}}">{{status===1?'马上抢购':'查看商品'}}</view></block></view></view></view></block><block wx:if="{{empty}}"><view style="{{'width:'+('100%')+';'+('height:'+(botHeight+'rpx')+';')}}" class="data-v-f07142fa"></view></block></view>