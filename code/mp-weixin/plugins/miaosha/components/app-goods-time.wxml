<view class="app-goods-time data-v-d9394eea"><view class="app-image data-v-d9394eea" style="{{'background-color:'+(theme.background)+';'}}"></view><view class="app-content dir-top-nowrap data-v-d9394eea"><block wx:if="{{miaosha_status===1}}"><view class="app-text data-v-d9394eea">距离结束仅剩</view></block><block wx:if="{{miaosha_status===2}}"><view class="app-text data-v-d9394eea">距离开始仅剩</view></block><block wx:if="{{miaosha_status===0}}"><view class="app-text over-text data-v-d9394eea">活动已结束</view></block><block wx:if="{{miaosha_status!==0}}"><view class="app-time cross-center main-around data-v-d9394eea"><block wx:if="{{day>0}}"><text class="app-num app-right data-v-d9394eea">{{day}}</text></block><block wx:if="{{day>0}}"><text class="data-v-d9394eea">天</text></block><text class="app-num app-right data-v-d9394eea">{{hour}}</text><text class="data-v-d9394eea">:</text><text class="app-num app-right data-v-d9394eea">{{minute}}</text><text class="data-v-d9394eea">:</text><text class="app-num app-right data-v-d9394eea">{{second}}</text></view></block></view></view>