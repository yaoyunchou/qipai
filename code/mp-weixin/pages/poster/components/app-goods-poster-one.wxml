<view class="app-goods-poster-one main-center data-v-3b69c6db"><view class="box data-v-3b69c6db" style="{{'background:'+(''+background)+';'+('transform:'+('scale('+multiple+','+multiple+')')+';')}}"><view class="head cross-center data-v-3b69c6db"><image src="{{info.avatar}}" class="data-v-3b69c6db"></image><view class="nickname main-center cross-center data-v-3b69c6db">{{''+info.nickname+customize+''}}</view></view><view class="goods-image data-v-3b69c6db"><app-poster-image vue-id="17dd16ed-1" form="{{form}}" info="{{info}}" class="data-v-3b69c6db" bind:__l="__l"></app-poster-image></view><view class="end dir-left-nowrap data-v-3b69c6db"><view class="dir-top-nowrap goods-info data-v-3b69c6db"><view class="goods-name t-omit-two data-v-3b69c6db">{{info.goods_name}}</view><view class="goods-price data-v-3b69c6db"><app-poster-price vue-id="17dd16ed-2" info="{{info}}" class="data-v-3b69c6db" bind:__l="__l"></app-poster-price></view><view class="goods-remark data-v-3b69c6db">{{info.extra_mark&&info.extra_mark[0]?info.extra_mark[0]:'长按识别小程序码进入'}}</view></view><view class="poster cross-center data-v-3b69c6db"><image src="{{info.qrcode_url}}" class="data-v-3b69c6db"></image></view></view></view></view>