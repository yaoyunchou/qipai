<view class="app-goods-poster-two main-center data-v-25d5f1b8"><view class="box data-v-25d5f1b8" style="{{'background:'+(''+background)+';'+('transform:'+('scale('+multiple+','+multiple+')')+';')}}"><view class="goods-image data-v-25d5f1b8"><app-poster-image vue-id="0c6b82c7-1" form="{{form}}" info="{{info}}" class="data-v-25d5f1b8" bind:__l="__l"></app-poster-image></view><view class="dir-top-nowrap end-bg data-v-25d5f1b8" style="{{'background-image:'+('url('+appImg.style_two_end_shadow+')')+';'}}"><view class="goods-name t-omit-two data-v-25d5f1b8">{{info.goods_name}}</view><view class="{{['data-v-25d5f1b8',info.sign==='flash_sale'?'flash-sale':'goods-price']}}"><app-poster-price vue-id="0c6b82c7-2" info="{{info}}" class="data-v-25d5f1b8" bind:__l="__l"></app-poster-price></view><view class="dir-left-nowrap end-info cross-center data-v-25d5f1b8"><view class="dir-top-nowrap data-v-25d5f1b8"><view class="dir-left-nowrap cross-center user data-v-25d5f1b8"><image class="box-grow-0 data-v-25d5f1b8" src="{{info.avatar}}"></image><view class="t-omit dir-top-nowrap data-v-25d5f1b8"><view class="data-v-25d5f1b8">{{info.nickname}}</view><block wx:if="{{info.extra_mark&&info.extra_mark[5]}}"><view class="data-v-25d5f1b8">{{info.extra_mark[5]}}</view></block></view></view><view class="goods-remark dir-left-nowrap data-v-25d5f1b8"><view class="dir-left-nowrap cross-center data-v-25d5f1b8"><view class="data-v-25d5f1b8">{{info.extra_mark&&info.extra_mark[1]?info.extra_mark[1]:'长按识别小程序码进入'}}</view><icon class="icon-three-arrow data-v-25d5f1b8" type="{{true}}"></icon></view></view></view><view class="poster-qrcode data-v-25d5f1b8"><image src="{{info.qrcode_url}}" class="data-v-25d5f1b8"></image></view></view></view></view></view>