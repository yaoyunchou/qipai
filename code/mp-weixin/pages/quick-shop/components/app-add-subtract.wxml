<view class="app-add-subtract dir-left-nowrap main-right cross-center data-v-f0ad017e"><block wx:if="{{number>0}}"><image class="app-icon data-v-f0ad017e" src="./../image/subtract.png" data-event-opts="{{[['tap',[['subtract',['$event']]]]]}}" bindtap="__e"></image></block><block wx:if="{{number>=0}}"><input class="app-input data-v-f0ad017e" type="number" data-event-opts="{{[['input',[['changeNum',['$event']]]]]}}" value="{{number<item.goods_num?number:item.goods_num}}" bindinput="__e"/></block><view data-event-opts="{{[['tap',[['add',['$event']]]]]}}" class="app-icon main-center cross-center data-v-f0ad017e" style="{{'background-color:'+(theme.background)+';'+('visibility:'+(number<item.goods_num?'visible':'hidden')+';')}}" bindtap="__e"><image hidden="{{!(loading)}}" src="./../image/add.png" data-event-opts="{{[['load',[['imgLoad',['$event']]]]]}}" bindload="__e" class="data-v-f0ad017e"></image></view></view>